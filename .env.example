# Copy to .env (git-ignored) and edit. Real environment variables override this file.
# Keys: run `python scripts/make_dev_keys.py` for dev; in production the host's key service injects them.

# --- Mode ---
KOMUTE_ENV=dev                      # dev | production (production forces an API key >= 24 chars and a liveness model)

# --- Secrets (never commit) ---
KOMUTE_API_KEY=                     # empty = no authentication (local testing only)
KOMUTE_STORAGE_KEY_B64=             # 32 bytes, base64
KOMUTE_STORAGE_KEY_ID=
KOMUTE_MANIFEST_KEY_B64=            # 32 bytes, base64
KOMUTE_MANIFEST_KEY_ID=

# --- Paths (storage must be outside OneDrive) ---
KOMUTE_STORAGE_ROOT=
KOMUTE_MODELS_DIR=backend/models
KOMUTE_LIVENESS_MODEL=
KOMUTE_DEV_SKIP_LIVENESS=false
KOMUTE_RESPONSE_BARCODE_FIELDS=false  # true returns every decoded barcode element (personal data)

# --- Decision thresholds ---
KOMUTE_FACE_MATCH_THRESHOLD=0.40    # cosine; provisional, calibrate on data
KOMUTE_FACE_DETECT_SCORE=0.7
KOMUTE_LIVENESS_THRESHOLD=0.5
KOMUTE_NAME_MATCH_THRESHOLD=90      # token-sort fuzzy %; class, dates, number and DOB are exact
KOMUTE_MIN_AGE=18
KOMUTE_PLATE_DETECT_SCORE=0.35
KOMUTE_PLATE_MIN_CONFIDENCE=0.6

# --- Limits ---
KOMUTE_MAX_UPLOAD_BYTES=10000000
KOMUTE_MAX_IMAGE_SIDE=2048
KOMUTE_COMPRESSED_MAX_SIDE=1280
KOMUTE_MAX_TEXT_CHARS=200
KOMUTE_BARCODE_BUDGET_S=10
KOMUTE_RETRY_AFTER_S=5
KOMUTE_WARMUP_MAX_RSS_MB=400        # 0 disables start-up warm-up

# --- Retention ---
KOMUTE_REJECTED_IMAGES_TTL_H=72
KOMUTE_APPROVED_ORIGINALS_TTL_D=30
KOMUTE_SWEEP_INTERVAL_S=3600
